# PulseOrder Backend Environment Configuration Template
ENVIRONMENT=production
PROJECT_NAME=PulseOrder
VERSION=1.0.0
API_V1_STR=/api/v1

# PostgreSQL Databases
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pulseorder_db
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/pulseorder_db

# Security & Authentication
SECRET_KEY=change_this_to_a_long_random_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Table QR Signing Secret
TABLE_TOKEN_SECRET=change_this_table_hmac_secret_in_production

